{
  "name": "open-antd-component-spec",
  "version": "1.0.1",
  "description": "An MCP Server for querying Ant Design component documentation",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "open-antd-component-spec": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "inspect": "pnpm dlx @modelcontextprotocol/inspector node dist/index.js",
    "watch:input": "rolldown -c -w",
    "watch:output": "nodemon --watch dist/index.js --exec \"pnpm run inspect\"",
    "dev": "rolldown -c && concurrently -k -n \"build,server\" \"pnpm run watch:input\" \"pnpm run watch:output\"",
    "build": "rolldown -c",
    "typecheck": "tsgo --build"
  },
  "keywords": [],
  "author": "201620114058@mail.scut.edu.cn",
  "license": "ISC",
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.21.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.6.0",
    "@types/semver": "^7.7.1",
    "@typescript/native-preview": "7.0.0-dev.20260430.1",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "rolldown": "^1.0.1"
  },
  "dependencies": {
    "@ant-design/md-to-json-schema": "^1.2.3",
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/server": "2.0.0-alpha.2",
    "lodash-es": "^4.18.1",
    "rxjs": "8.0.0-alpha.14",
    "semver": "^7.8.1",
    "zod": "^4.4.3"
  }
}
